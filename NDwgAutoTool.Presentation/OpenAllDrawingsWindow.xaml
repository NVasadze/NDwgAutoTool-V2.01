<Window x:Class="NDwgAutoTool.OpenAllDrawingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open All"
        Height="420"
        Width="460"
        MinWidth="400"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Style="{StaticResource DialogShellBorderStyle}"
            MouseLeftButtonDown="WindowDragArea_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DialogTitleTextBlock"
                           Text="Open All"
                           Style="{StaticResource DialogTitleTextStyle}"/>

                <Button Grid.Column="1"
                        Click="CloseButton_Click"
                        Style="{StaticResource DialogCloseButtonStyle}"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource DialogContentBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="OptionsTopSpacerRow" Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="OptionsBottomSpacerRow" Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="InputLabelTextBlock"
                               Text="Number(s)"
                               Style="{StaticResource DialogBodyTextStyle}"/>

                    <Grid Grid.Row="2">
                        <TextBox x:Name="DrawingNumbersTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource AppTextBrush}"
                                 FontFamily="Consolas"
                                 FontSize="13"/>
                        <TextBlock Text="Enter drawing numbers"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   FontStyle="Italic"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DrawingNumbersTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock x:Name="OptionsLabelTextBlock"
                               Grid.Row="4"
                               Text="Open"
                               Style="{StaticResource DialogBodyTextStyle}"/>

                    <UniformGrid x:Name="OptionsPanel"
                                 Grid.Row="6"
                                 Columns="3">
                        <CheckBox x:Name="DrawingsCheckBox"
                                  Content="Drawings"
                                  Style="{StaticResource DialogCheckBoxStyle}"/>
                        <CheckBox x:Name="ContainersCheckBox"
                                  Content="Containers"
                                  Style="{StaticResource DialogCheckBoxStyle}"/>
                        <CheckBox x:Name="ModelsCheckBox"
                                  Content="Models"
                                  Style="{StaticResource DialogCheckBoxStyle}"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"
                        Style="{StaticResource DialogButtonStyle}"/>
                <Button x:Name="PrimaryButton"
                        Content="Open"
                        Click="OpenButton_Click"
                        Style="{StaticResource DialogPrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>






