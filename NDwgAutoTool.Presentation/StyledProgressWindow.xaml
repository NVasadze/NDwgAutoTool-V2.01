<Window x:Class="NDwgAutoTool.StyledProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progress"
        Height="260"
        Width="500"
        MinWidth="380"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Style="{StaticResource DialogShellBorderStyle}"
            MouseLeftButtonDown="WindowDragArea_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Text="Processing"
                           Style="{StaticResource DialogTitleTextStyle}"/>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Click="CloseButton_Click"
                        Style="{StaticResource DialogCloseButtonStyle}"/>
            </Grid>

            <TextBlock Grid.Row="2"
                       x:Name="StatusTextBlock"
                       Text="Preparing..."
                       Foreground="{StaticResource AppMutedTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="4" Style="{StaticResource DialogContentBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="CurrentItemTextBlock"
                               Text="Current: -"
                               Margin="0,0,0,10"
                               Style="{StaticResource DialogBodyTextStyle}"/>

                    <ProgressBar x:Name="MainProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock x:Name="CountTextBlock"
                                   Text="0 / 0"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   FontSize="12"
                                   DockPanel.Dock="Left"/>

                        <TextBlock x:Name="PercentTextBlock"
                                   Text="0%"
                                   Foreground="{StaticResource AppTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Click="CancelButton_Click"
                        Style="{StaticResource DialogButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
