<Window x:Class="NDwgAutoTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NDwgAutoTool V2.01"
        Height="430"
        Width="820"
        MinHeight="410"
        MinWidth="210"
        WindowStartupLocation="CenterScreen"
        Background="#101317"
        WindowStyle="None"
        Topmost="True"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101317"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171B21"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#12161C"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2C333D"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#222933"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2C3642"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F8F7B"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#38A98F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB4C0"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="156"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#486070"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A2028"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#55B8A4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#20262E"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#303A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A33A43"/>
                    <Setter Property="BorderBrush" Value="#C85A63"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#141920"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SW Tool"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" V2.01"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="4,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="_"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="MaxRestoreButton"
                                Content="□"
                                Click="MaxRestoreButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="X"
                                Click="CloseWindowButton_Click"
                                Style="{StaticResource CloseTitleBarButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="190"/>
                    <ColumnDefinition x:Name="LeftSpacerColumn" Width="10"/>
                    <ColumnDefinition x:Name="MiddleColumn" Width="*"/>
                    <ColumnDefinition x:Name="RightSpacerColumn" Width="10"/>
                    <ColumnDefinition x:Name="RightColumn" Width="190"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="LeftPanel"
                        Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button x:Name="ToggleLayoutButton"
                                    Content="SHOW MORE"
                                    Click="ToggleLayoutButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,0,0,9"/>

                            <TextBlock Text="Active Drawing"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Button Content="Create Flagnotes"
                                    Click="CreateFlagnotesButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Attach Dim4"
                                    Click="AttachDim4Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Reverse Dim4"
                                    Click="ReverseDim4Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Apply Selected 2/3"
                                    Click="ApplySelected23Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Create FORM 3"
                                    Click="CreateForm3Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Create PDF"
                                    Click="CreatePdfButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="CheckDWG"
                                    Click="CheckDwgButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Generate Notes"
                                    Click="GenerateNotesButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Update Signature"
                                    Click="UpdateSignatureButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Fill Title Block"
                                    Click="FillTitleBlockButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="MiddlePanel"
                        Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Root"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"/>

                            <TextBox x:Name="NetworkRootPathTextBox"
                                     Grid.Column="1"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextBrush}"
                                     Background="{StaticResource PanelAltBrush}"
                                     BorderBrush="{StaticResource BorderBrushSoft}"
                                     BorderThickness="1"
                                     IsReadOnly="False"
                                     TextChanged="NetworkRootPathTextBox_TextChanged"
                                     FontSize="13"
                                     Padding="10,0"/>

                            <Button Grid.Column="3"
                                    Width="76"
                                    Content="Clear Log"
                                    Click="ClearLogButton_Click"
                                    Style="{StaticResource SmallButtonStyle}"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <TextBox x:Name="LogTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="RightPanel"
                        Grid.Column="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="All Open Drawings"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                            <Button Content="Open All"
                                    Click="OpenAllButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}"/>
                            <Button Content="Create Flagnotes For All"
                                    Click="CreateFlagnotesForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Attach Dim4 For All"
                                    Click="AttachDim4ForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Create FORM 3 For All"
                                    Click="CreateForm3ForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Create PDF For All"
                                    Click="CreatePdfForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="CheckDWG For All"
                                    Click="CheckDwgForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Generate Notes For All"
                                    Click="GenerateNotesForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Update Signature For All"
                                    Click="UpdateSignatureForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Fill Title Block For All"
                                    Click="FillTitleBlockForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Save All"
                                    Click="SaveAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Close All"
                                    Click="CloseAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
