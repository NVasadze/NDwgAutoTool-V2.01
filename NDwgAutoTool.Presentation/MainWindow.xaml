<Window x:Class="NDwgAutoTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NDwgAutoTool V2.04"
        Height="505"
        Width="820"
        MinHeight="505"
        MinWidth="210"
        WindowStartupLocation="CenterScreen"
        Background="#101317"
        WindowStyle="None"
        Topmost="True"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101317"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171B21"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#12161C"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2C333D"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#222933"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2C3642"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F8F7B"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#38A98F"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F5F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB4C0"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#486070"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A2028"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#55B8A4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#8E3A42"/>
            <Setter Property="BorderBrush" Value="#C85A63"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A94750"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SectionToggleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#20262E"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A2028"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#20262E"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#303A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A33A43"/>
                    <Setter Property="BorderBrush" Value="#C85A63"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="#141920"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="AppTitlePanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitleTextBlock"
                                   Text="SW Tool"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="AppVersionTextBlock"
                                   Text=" V2.04"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="4,2,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="TitleBarButtonsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,-3,0,0">
                        <Button Content="_"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button x:Name="MaxRestoreButton"
                                Content="□"
                                Click="MaxRestoreButton_Click"
                                Style="{StaticResource TitleBarButtonStyle}"/>
                        <Button Content="X"
                                Click="CloseWindowButton_Click"
                                Style="{StaticResource CloseTitleBarButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainContentGrid"
                  Grid.Row="1"
                  Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="190"/>
                    <ColumnDefinition x:Name="LeftSpacerColumn" Width="10"/>
                    <ColumnDefinition x:Name="MiddleColumn" Width="*"/>
                    <ColumnDefinition x:Name="RightSpacerColumn" Width="10"/>
                    <ColumnDefinition x:Name="RightColumn" Width="190"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="LeftPanel"
                        Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9">
                    <ScrollViewer x:Name="LeftPanelScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="LeftCommandFlowPanel"
                                   Orientation="Vertical">
                            <Button x:Name="ToggleLayoutButton"
                                    Content="SHOW MORE"
                                    Click="ToggleLayoutButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,0,0,9"/>

                            <Button x:Name="OpenAllButton"
                                    Content="Open All"
                                    Click="OpenAllButton_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,0,0,9"/>

                            <TextBlock x:Name="ActiveDrawingHeaderTextBlock"
                                       Text="Active Drawing"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>

                            <Button x:Name="CompactOrientationToggleButton"
                                    Content="Horizontal"
                                    Click="CompactOrientationToggleButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Visibility="Collapsed"/>

                            <Button Content="Create Flagnotes"
                                    Click="CreateFlagnotesButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Attach Dim4"
                                    Click="AttachDim4Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Reverse Dim4"
                                    Click="ReverseDim4Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Apply Selected 2/3"
                                    Click="ApplySelected23Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Create FORM 3"
                                    Click="CreateForm3Button_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Create PDF"
                                    Click="CreatePdfButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="CheckDWG"
                                    Click="CheckDwgButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Generate Notes"
                                    Click="GenerateNotesButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Update Signature"
                                    Click="UpdateSignatureButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Fill Title Block"
                                    Click="FillTitleBlockButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="Close All"
                                    Click="CloseAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0"/>
                        </WrapPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="MiddlePanel"
                        Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Root"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0"/>

                            <TextBox x:Name="NetworkRootPathTextBox"
                                     Grid.Column="1"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextBrush}"
                                     Background="{StaticResource PanelAltBrush}"
                                     BorderBrush="{StaticResource BorderBrushSoft}"
                                     BorderThickness="1"
                                     IsReadOnly="False"
                                     TextChanged="NetworkRootPathTextBox_TextChanged"
                                     FontSize="13"
                                     Padding="10,0"/>

                            <Button Grid.Column="3"
                                    Width="76"
                                    Content="Clear Log"
                                    Click="ClearLogButton_Click"
                                    Style="{StaticResource SmallButtonStyle}"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <TextBox x:Name="LogTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="RightPanel"
                        Grid.Column="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="7">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Batch Groups"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>

                            <Expander x:Name="DrawingBatchExpander"
                                      Header="Drawing Batch"
                                      IsExpanded="False"
                                      Foreground="{StaticResource TextBrush}"
                                      Background="{StaticResource ButtonBrush}"
                                      Margin="0,0,0,6">
                                <StackPanel Margin="0,4,0,0">
                                    <Grid>
                                        <TextBox x:Name="DrawingBatchNumbersTextBox"
                                                 Height="38"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Background="{StaticResource PanelAltBrush}"
                                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                                 BorderThickness="1"
                                                 FontSize="11"
                                                 Padding="6"
                                                 ToolTip="Enter drawing numbers"/>
                                        <TextBlock Text="Enter drawing numbers"
                                                   Foreground="#6F7A86"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   Margin="8,6,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DrawingBatchNumbersTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <WrapPanel Margin="0,5,0,4">
                                        <CheckBox x:Name="DrawingBatchOpenAllCheckBox"
                                                  Content="Open All"
                                                  Foreground="{StaticResource TextBrush}"
                                                  FontSize="10.5"
                                                  Margin="0,0,10,3"/>
                                        <CheckBox x:Name="DrawingBatchSaveAllCheckBox"
                                                  Content="Save All"
                                                  Foreground="{StaticResource TextBrush}"
                                                  FontSize="10.5"
                                                  Margin="0,0,10,3"/>
                                        <CheckBox x:Name="DrawingBatchCloseAllCheckBox"
                                                  Content="Close All"
                                                  Foreground="{StaticResource TextBrush}"
                                                  FontSize="10.5"
                                                  Margin="0,0,10,3"/>
                                    </WrapPanel>
                                    <Button Content="Run Selected"
                                            Click="RunDrawingBatchSelectedButton_Click"
                                            Height="24"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="DrawingToolsBatchExpander"
                                      Header="Drawing Tools"
                                      IsExpanded="False"
                                      Foreground="{StaticResource TextBrush}"
                                      Background="{StaticResource ButtonBrush}"
                                      Margin="0,0,0,6">
                                <StackPanel Margin="0,4,0,0">
                                    <Grid>
                                        <TextBox x:Name="ToolBatchNumbersTextBox"
                                                 Height="38"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Background="{StaticResource PanelAltBrush}"
                                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                                 BorderThickness="1"
                                                 FontSize="11"
                                                 Padding="6"
                                                 ToolTip="Enter drawing numbers"/>
                                        <TextBlock Text="Enter drawing numbers"
                                                   Foreground="#6F7A86"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   Margin="8,6,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ToolBatchNumbersTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Margin="0,5,0,4">
                                        <CheckBox x:Name="ToolBatchCreateFlagnotesCheckBox" Content="Create Flagnotes For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchAttachDim4CheckBox" Content="Attach Dim4 For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchReverseDim4CheckBox" Content="Reverse Dim4 For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchGenerateNotesCheckBox" Content="Generate Notes For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchUpdateSignatureCheckBox" Content="Update Signature For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchFillTitleBlockCheckBox" Content="Fill Title Block For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchCreateForm3CheckBox" Content="Create FORM 3 For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchCreatePdfCheckBox" Content="Create Check PDF For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                        <CheckBox x:Name="ToolBatchPdfNoCheckCheckBox" Content="Create PDF For All" Foreground="{StaticResource TextBrush}" FontSize="10.5" Margin="0,0,0,2"/>
                                    </StackPanel>
                                    <Button Content="Run Selected"
                                            Click="RunToolBatchSelectedButton_Click"
                                            Height="24"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                </StackPanel>
                            </Expander>

                            <Button Content="CheckDWG For All"
                                    Click="CheckDwgForAllButton_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0"/>
                                            </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>










